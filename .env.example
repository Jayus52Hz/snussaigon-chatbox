HOST=127.0.0.1
PORT=8788
# Reuse your local Codex CLI login (codex login) without an API key.
AI_PROVIDER=codex
MODEL=gpt-5.6-luna
# Optional: full path to a newer Codex CLI if PATH points to an older one.
# CODEX_BIN=C:/path/to/codex.exe
# Optional legacy provider: AI_PROVIDER=anthropic and an Anthropic MODEL.
ANTHROPIC_API_KEY=
